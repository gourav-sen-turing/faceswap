# Environment Configuration Template
# Copy this file to .env and configure with your settings

# Application Environment
ENVIRONMENT=production  # development, staging, production
APP_NAME=Face Quality Assessment Service
APP_VERSION=1.0.0
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4
API_PREFIX=/api/v1

# Security Configuration
API_KEY=your-super-secret-api-key-change-this
SECRET_KEY=your-jwt-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Authentication
ENABLE_API_KEY_AUTH=true
ENABLE_JWT_AUTH=true
API_KEY_HEADER=X-API-Key

# Database Configuration
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=face_quality_db
MONGO_USERNAME=admin
MONGO_PASSWORD=secure_password

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
CACHE_TTL=3600

# GPU Configuration
GPU_ENABLED=true
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
ENABLE_MIXED_PRECISION=true

# Quality Assessment Thresholds
# Blur Detection (Laplacian variance)
BLUR_THRESHOLD_MIN=100.0
BLUR_THRESHOLD_REJECT=50.0

# Pose Estimation (degrees)
POSE_YAW_MAX=30.0
POSE_PITCH_MAX=25.0
POSE_ROLL_MAX=20.0

# Lighting Analysis (normalized 0-255)
LIGHTING_MIN=40.0
LIGHTING_MAX=220.0
LIGHTING_CONTRAST_MIN=30.0

# Resolution Assessment (pixels)
RESOLUTION_MIN_WIDTH=224
RESOLUTION_MIN_HEIGHT=224
RESOLUTION_RECOMMENDED_WIDTH=512
RESOLUTION_RECOMMENDED_HEIGHT=512

# Face Detection
FACE_DETECTION_CONFIDENCE=0.7
MIN_FACE_SIZE=50
MAX_FACES=10

# Quality Score Thresholds (0-1)
QUALITY_SCORE_ACCEPT=0.75
QUALITY_SCORE_ENHANCE=0.50
QUALITY_SCORE_REJECT=0.30

# Super Resolution
ENABLE_SUPER_RESOLUTION=true
SR_SCALE_FACTOR=4
SR_MODEL=RealESRGAN

# Image Processing
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,bmp,webp
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
CACHE_DIR=./cache

# Model Paths
MODELS_DIR=./models
FACE_DETECTOR_MODEL=dlib
LANDMARK_MODEL=shape_predictor_68_face_landmarks.dat
SR_MODEL_PATH=./models/RealESRGAN_x4plus.pth

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
ENABLE_STRUCTURED_LOGGING=true

# Monitoring & Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS Configuration
ENABLE_CORS=true
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=*

# Performance Tuning
ASYNC_WORKERS=4
BATCH_SIZE=8
QUEUE_MAX_SIZE=1000
REQUEST_TIMEOUT=300

# Storage Configuration
STORAGE_TYPE=local  # local, s3, azure, gcs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Notification Configuration
ENABLE_NOTIFICATIONS=false
WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Feature Flags
ENABLE_BATCH_PROCESSING=true
ENABLE_ASYNC_PROCESSING=true
ENABLE_RESULT_CACHING=true
ENABLE_AUTO_ENHANCEMENT=true

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Development Settings (for development environment only)
RELOAD=false
TESTING=false
MOCK_GPU=false
