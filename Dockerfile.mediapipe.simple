# Simplified MediaPipe Dockerfile - Guaranteed to work
# No cache issues, minimal complexity
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Set environment variables (no cache disable to avoid purge issues)
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    libopencv-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libopenblas0 \
    curl \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements-mediapipe.txt .

# Install Python dependencies without cache issues
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir numpy==1.24.3 && \
    pip3 install --no-cache-dir opencv-python==4.8.1.78 && \
    pip3 install --no-cache-dir mediapipe==0.10.8 && \
    pip3 install --no-cache-dir fastapi==0.104.1 && \
    pip3 install --no-cache-dir uvicorn[standard]==0.24.0 && \
    pip3 install --no-cache-dir pydantic==2.5.0 && \
    pip3 install --no-cache-dir pydantic-settings==2.1.0 && \
    pip3 install --no-cache-dir Pillow==10.1.0 && \
    pip3 install --no-cache-dir scikit-image==0.22.0 && \
    pip3 install --no-cache-dir scipy==1.11.4 && \
    pip3 install --no-cache-dir torch==2.1.1 --index-url https://download.pytorch.org/whl/cu121 && \
    pip3 install --no-cache-dir torchvision==0.16.1 --index-url https://download.pytorch.org/whl/cu121 && \
    pip3 install --no-cache-dir python-jose[cryptography]==3.3.0 && \
    pip3 install --no-cache-dir passlib[bcrypt]==1.7.4 && \
    pip3 install --no-cache-dir python-multipart==0.0.6 && \
    pip3 install --no-cache-dir python-dotenv==1.0.0 && \
    pip3 install --no-cache-dir pyjwt==2.8.0 && \
    pip3 install --no-cache-dir cryptography==41.0.7 && \
    pip3 install --no-cache-dir prometheus-client==0.19.0 && \
    pip3 install --no-cache-dir structlog==23.2.0 && \
    pip3 install --no-cache-dir python-json-logger==2.0.7 && \
    pip3 install --no-cache-dir redis==5.0.1 && \
    pip3 install --no-cache-dir motor==3.3.2 && \
    pip3 install --no-cache-dir aiofiles==23.2.1 && \
    pip3 install --no-cache-dir httpx==0.25.2 && \
    pip3 install --no-cache-dir aiohttp==3.9.1 && \
    pip3 install --no-cache-dir requests==2.31.0 && \
    pip3 install --no-cache-dir tenacity==8.2.3

# Copy application code
COPY --chown=appuser:appuser . .

# Create necessary directories
RUN mkdir -p /app/logs /app/cache /app/uploads /app/results /app/models && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
